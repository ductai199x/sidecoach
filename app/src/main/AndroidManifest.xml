<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Screen capture runs in a foreground service the system shows a chip for: the
         person always knows the screen is being read, and the service is killed with
         the app. Nothing here reads the network. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The engine's network is fetched once, as the desktop fetches the engine. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SidecoachApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sidecoach">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Sidecoach">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Debug only: a rendered board on the screen, so the vision can be tried
             without a chess app in front. -->
        <activity
            android:name=".debug.BoardActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Test board" />

        <service
            android:name=".capture.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
