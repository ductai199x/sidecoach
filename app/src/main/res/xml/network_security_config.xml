<?xml version="1.0" encoding="utf-8"?>
<!--
  The panel's page is served by the app to itself over plain HTTP on the loopback address,
  so that the frontend is the desktop's own and talks to the backend the same way it does
  there. Android forbids cleartext by default, and rightly; this permits it for 127.0.0.1
  and nothing else. Everything the app fetches from the world (the engine's network, a
  model) stays HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
