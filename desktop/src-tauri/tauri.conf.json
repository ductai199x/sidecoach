{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sidecoach",
  "version": "0.1.17",
  "mainBinaryName": "sidecoach",
  "identifier": "sidecoach",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sidecoach",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Tai Duc Nguyen",
    "shortDescription": "Sidecoach: a chess coaching companion that watches your screen",
    "longDescription": "Vision-first chess coaching companion. Watches the board on your screen, follows the game, annotates with Stockfish and coaches Socratically -- with a model of your choice, or none at all.",
    "category": "Education",
    "resources": {
      "../resources/python/": "python/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libportaudio2"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis/hooks.nsh",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1OTE3MzVBQUNCQTdBN0IKUldSN2VycXNXbk9SdGRjcHVVZjFOc0dmbXMzWWVaZ3Y1NTlsYUZ1bk1vUnJTOWVOZXpSREZsa3QK",
      "endpoints": [
        "https://github.com/ductai199x/sidecoach/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
